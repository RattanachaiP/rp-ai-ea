{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rp-ai:execution-context:PR192-EXECUTION-CONTEXT.1",
  "title": "ExecutionContext",
  "description": "The sole immutable V26 Runtime-to-MT5 Executor payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_uuid",
    "decision_uuid",
    "package_uuid",
    "replay_uuid",
    "execution_confidence",
    "readiness_state",
    "environment_state",
    "feasibility_state",
    "policy_version",
    "engine_version",
    "advisory_only",
    "timestamp",
    "contract_version",
    "payload_digest"
  ],
  "properties": {
    "execution_uuid": {"type": "string", "format": "uuid"},
    "decision_uuid": {"type": "string", "format": "uuid"},
    "package_uuid": {"type": "string", "format": "uuid"},
    "replay_uuid": {"type": "string", "format": "uuid"},
    "execution_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "readiness_state": {"type": "string", "minLength": 1},
    "environment_state": {"type": "string", "minLength": 1},
    "feasibility_state": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "engine_version": {"type": "string", "minLength": 1},
    "advisory_only": {"const": true},
    "timestamp": {"type": "string", "format": "date-time"},
    "contract_version": {"const": "PR192-EXECUTION-CONTEXT.1"},
    "payload_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
